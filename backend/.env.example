# Database Configuration
# Use sqlite:///./vkbathouse.db for zero-config local development, or Supabase PostgreSQL connection string for production:
DATABASE_URL=sqlite:///./vkbathouse.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage Configuration (Optional / Production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=vkbathouse-media

# Security / JWT
JWT_SECRET_KEY=vk_bathouse_super_secret_jwt_key_development_change_in_production_9837429873498
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business / Financial Settings
GST_PERCENTAGE=12.0
DEFAULT_SHIPPING_FEE=150.0
FREE_SHIPPING_THRESHOLD=15000.0
WHATSAPP_NUMBER=919876543210
CONTACT_EMAIL=support@vkbathouse.com

# Razorpay Keys (Optional for live payments, mock mode active when empty)
